# ==============================================================================
# CONFIGURAÇÕES DO CERTIFICADO DIGITAL ICP-BRASIL (SEFAZ-SP / NF-e v4.00)
# ==============================================================================
# Para o Vercel Serverless Function ou Node Express:
# O certificado DEVE ser do tipo A1 (.pfx / PKCS#12) exportado em Base64 de linha única.
# Como gerar a string Base64 no terminal Linux/macOS:
#   base64 -w 0 certificado.pfx > cert_base64.txt
# Ou no Windows PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("certificado.pfx")) | Set-Content cert_base64.txt
#
# Copie o conteúdo e cole na variável NFE_CERT_BASE64 no Vercel (Project Settings -> Environment Variables)
NFE_CERT_BASE64=
NFE_CERT_PASSWORD=

# Alternativas aceitas pelo sistema para o certificado A1:
SEFAZ_CERT_BASE64=
SEFAZ_CERT_PASSWORD=
CERTIFICADO_A1_BASE64=
CERTIFICADO_A1_SENHA=

# Para execução local com arquivo em disco:
NFE_CERT_PATH=

# Para certificado em formato PEM (caso utilize cert e chave privada separados):
NFE_CERT_PEM=
NFE_KEY_PEM=

# Ambiente SEFAZ: '1' para Produção ou '2' para Homologação (padrão: 1)
SEFAZ_TP_AMB=1
SEFAZ_ENV=producao
NFE_ENV=producao

# ==============================================================================
# URLS DE API / PROXY
# ==============================================================================
VITE_SEFAZ_PROXY_URL=/api/sefaz/soap
VITE_NFE_API_URL=/api/sefaz/soap
VITE_SEFAZ_API_URL=/api/sefaz/soap
VITE_NFE_AUTORIZACAO_URL=
VITE_NFE_CONSULTA_URL=
VITE_NFE_EVENTO_URL=
VITE_NFE_STATUS_URL=

# ==============================================================================
# BANCO DE DADOS SUPABASE
# ==============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=