# Configuração do Ambiente SEFAZ para NF-e Modelo 55 (1 = Produção, 2 = Homologação)
# Por padrão, o UsiCorte opera em PRODUÇÃO (tpAmb = 1) com validade jurídica nacional
NFE_ENV=1
SEFAZ_ENV=1
VITE_NFE_ENV=1
VITE_SEFAZ_ENV=1

# URLs dos WebServices Oficiais da SEFAZ-SP (Produção - Ambiente 1)
# Autorização / Envio de NF-e v4.00 (MOC SEFAZ):
VITE_NFE_AUTORIZACAO_URL=https://nfe.fazenda.sp.gov.br/ws/nfeautorizacao4.asmx
# Recepção de Eventos (Cancelamento e Carta de Correção Eletrônica):
VITE_NFE_EVENTO_URL=https://nfe.fazenda.sp.gov.br/ws/nferecepcaoevento4.asmx
# Consulta de Protocolo e Situação da NF-e:
VITE_NFE_CONSULTA_URL=https://nfe.fazenda.sp.gov.br/ws/nfeconsultaprotocolo4.asmx
# Consulta do Status do Serviço da SEFAZ-SP:
VITE_NFE_STATUS_URL=https://nfe.fazenda.sp.gov.br/ws/nfestatusservico4.asmx

# Endpoints de API / Proxy de transmissão (Apontando para a Produção SEFAZ-SP)
VITE_NFE_API_URL=https://nfe.fazenda.sp.gov.br/ws/nfeautorizacao4.asmx
VITE_SEFAZ_API_URL=https://nfe.fazenda.sp.gov.br/ws/nfeautorizacao4.asmx

# Supabase
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# Gemini API Key
GEMINI_API_KEY=