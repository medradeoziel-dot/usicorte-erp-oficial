# Variáveis de Ambiente - UsiCorte ERP
PORT=3000
NODE_ENV=development

# Certificado Digital A1 da Empresa (ICP-Brasil para transmissão SEFAZ)
# Informe o conteúdo do certificado .pfx em Base64 ou o caminho absoluto no servidor:
NFE_CERT_BASE64=
SEFAZ_CERT_BASE64=
NFE_CERT_PASSWORD=
SEFAZ_CERT_PASSWORD=
NFE_CERT_PATH=

# Chave Privada e Certificado PEM (opcional caso prefira formato .pem):
NFE_CERT_PEM=
NFE_KEY_PEM=

# Ambiente SEFAZ: 1 = Produção (Padrão Oficial), 2 = Homologação (Testes)
SEFAZ_TP_AMB=1
NFE_ENV=producao
SEFAZ_ENV=producao

# URLs WebServices SEFAZ (Opcionais - caso não informadas, o sistema utiliza os endpoints oficiais da SEFAZ-SP)
VITE_NFE_AUTORIZACAO_URL=
VITE_NFE_CONSULTA_URL=
VITE_NFE_EVENTO_URL=
VITE_NFE_STATUS_URL=
VITE_SEFAZ_API_URL=
VITE_NFE_API_URL=

# Banco de dados Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=